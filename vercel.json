{
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "redirects": [
    {
      "source": "/activies",
      "destination": "/activities",
      "permanent": true
    },
    {
      "source": "/activies/:path*",
      "destination": "/activities/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
